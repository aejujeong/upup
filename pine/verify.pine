    switch k
        'BTC|15|매수|50·100 동시 돌파' => [556.0, 35.0, -0.09, 1.02, -0.69, '24.12~26.11']
        'BTC|15|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배)' => [17.0, 35.0, -0.23, 1.23, -1.04, '25.01~26.10']

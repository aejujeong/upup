        => [na, na, na, na, na, ""]

czBigDn = mkt == "코인" and (tf == "30" or tf == "60" or tf == "240") and (s200 - s200[40]) / xAt < -1
czSym = isBTC ? "BTC" : str.contains(syminfo.ticker, "ETH") ? "ETH" : str.contains(syminfo.ticker, "SOXL") ? "SOXL" : ""
czTf = timeframe.isdaily ? "D" : tf
czBase(string t) => t == "1" or t == "3" or t == "5" ? "투매|투매 · 반등 여유 있음" : t == "15" ? "매수|저점 반등" : t == "60" and mkt == "코인" ? "매수|변동성 돌파일 돌파" : t == "D" ? "매수|터틀 (20일 고점 돌파)" : "매수|추세 돌파"
var string czKey = ""
var string czNm  = ""
var float  czE   = na
var float  czS   = na
var float  czT   = na
var int    czB   = na
var int    czK   = na
// 내 선 기준 과거 승률: 이 차트의 같은 종류 신호마다 종가에 들어가 내 손절·익절 폭(%)을 걸었다면
var czVE = array.new_float()
var czVK = array.new_int()
var czVB = array.new_int()
var czSN = array.new_int(2, 0)
var czSW = array.new_int(2, 0)
var czSP_ = array.new_float(2, 0.0)
if czMineOk and czVE.size() > 0
    for k = czVE.size() - 1 to 0
        float ve = czVE.get(k)
        int kk = czVK.get(k)
        float r = na
        if low <= ve * (1 - czDS / 100)
            r := -czDS
        else if high >= ve * (1 + czDT / 100)
            r := czDT
        else if bar_index - czVB.get(k) >= czHold
            r := (close / ve - 1) * 100
        if not na(r)
            r -= 2 * czFee
            czSN.set(kk, czSN.get(kk) + 1)
            czSW.set(kk, czSW.get(kk) + (r > 0 ? 1 : 0))
            czSP_.set(kk, czSP_.get(kk) + r)
            czVE.remove(k)
            czVK.remove(k)
            czVB.remove(k)
bool czSig0 = buy and not na(sl) and not krOv and mkt != "한국"
if czMineOk and czSig0
    czVE.push(close)
    czVK.push(0)
    czVB.push(bar_index)
if czMineOk and xOk
    czVE.push(close)
    czVK.push(1)
    czVB.push(bar_index)
if buy and not na(sl) and not krOv and mkt != "한국"
    czK   := 0
    czKey := czSym + "|" + czTf + "|" + czBase(czTf)
    czNm  := name
    czE   := close
    czS   := sl
    czT   := tp
    czB   := bar_index
if xOk
    czK   := 1
    czKey := czSym + "|" + czTf + "|매수|50·100 동시 돌파" + (xBot ? " (RSI 30 터치 + 거래량 3배)" : "") + (czBigDn ? " · 큰 흐름 하락 중" : "")
    czNm  := "50·100 동시 돌파" + (xBot ? " ★" : "") + (czBigDn ? " · 큰 흐름 하락 중" : "")
    czE   := close
    czS   := xSl
    czT   := xTp
    czB   := bar_index

czW(float v) => str.tostring(math.round(v), "#,##0") + "원"
czU(float v) => str.tostring(v / czFx, "#,##0.0") + " USDT"
czSg(float v) => v >= 0 ? "+" : ""
var line czLE = na
var line czLS = na
var line czLT = na
var label czBE = na
var label czBS = na
var label czBT = na
czCP = czPos == "오른쪽 위" ? position.top_right : czPos == "오른쪽 가운데" ? position.middle_right : czPos == "왼쪽 위" ? position.top_left : position.bottom_left
var table czTb = table.new(czCP, 2, 8, bgcolor = color.new(#111111, 10), border_color = color.new(#617B55, 0), border_width = 1, frame_color = color.new(#617B55, 0), frame_width = 1)
czC(int c, int r, string t, color bg = na, string tip = "") =>
    table.cell(czTb, c, r, t, text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = na(bg) ? color.new(#111111, 10) : bg, tooltip = tip)
// ───────── 이 차트 50·100 동시 돌파 성적 (★만 / 전체) · 트레이딩뷰 봉 그대로(야간 포함) · 신호 손절(종가-2ATR)·익절(+4ATR) ─────────
var xvE = array.new_float()
var xvS = array.new_float()
var xvT = array.new_float()
var xvB = array.new_int()
var xvR = array.new_bool()
var xvTm = array.new_int()
var xvF = array.new_bool()
var int xsFirst = na
// 거르기: 200선이 40봉 동안 평균 움직임 폭보다 많이 내려가는 중이거나, 위 200·400선이 czNear% 안에 있음
xOver = math.min(s200 > close ? s200 : 1e12, s400 > close ? s400 : 1e12)
xBadF = not (s200 > s200[40])   // [후보] 200선이 40봉 전보다 올라와 있을 때만 (5분봉 검증: 34회 · 승률 59% · 평균 +1.23%)
// 원금 한도 손절: 증거금 × 레버리지로 들어갔을 때 원금의 czRisk% 를 잃는 가격 폭
czCapPct = czMarg * czLev > 0 ? czRisk * czSeed / (czMarg * czLev) : na
var yvE = array.new_float()
var yvT = array.new_float()
var yvB = array.new_int()
var yvR = array.new_bool()
var ysN = array.new_int(2, 0)
var ysW = array.new_int(2, 0)
var ysP = array.new_float(2, 0.0)
yAdd(int k, float r) =>
    ysN.set(k, ysN.get(k) + 1)
    ysW.set(k, ysW.get(k) + (r > 0 ? 1 : 0))
    ysP.set(k, ysP.get(k) + r)
if not na(czCapPct) and yvE.size() > 0
    for k = yvE.size() - 1 to 0
        float ve = yvE.get(k)
        float r = na
        if low <= ve * (1 - czCapPct / 100)
            r := -czCapPct
        else if high >= yvT.get(k)
            r := (yvT.get(k) / ve - 1) * 100
        else if bar_index - yvB.get(k) >= czHold
            r := (close / ve - 1) * 100
        if not na(r)
            r -= 2 * czFee
            yAdd(1, r)
            if yvR.get(k)
                yAdd(0, r)
            yvE.remove(k)
            yvT.remove(k)
            yvB.remove(k)
            yvR.remove(k)
if xOk and not na(czCapPct)
    yvE.push(close)
    yvT.push(xTp)
    yvB.push(bar_index)
    yvR.push(xBot)
yStatTxt(int k) =>
    int n = ysN.get(k)
    n == 0 ? "아직 결과 없음" : str.tostring(n) + "번 · 승률 " + str.tostring(ysW.get(k) * 100.0 / n, "#") + "% · 한 번 평균 " + (ysP.get(k) >= 0 ? "+" : "") + str.tostring(ysP.get(k) / n, "#.##") + "% (원금 " + (ysP.get(k) >= 0 ? "+" : "") + str.tostring(ysP.get(k) / n * czMarg * czLev / czSeed, "#.##") + "%)"
var xsN = array.new_int(4, 0)      // 0 = ★만, 1 = 전체, 2 = 거른 ★, 3 = 거른 전체
var xsW = array.new_int(4, 0)
var xsP = array.new_float(4, 0.0)
var xsLast = array.new_string()
xAdd(int k, float r) =>
    xsN.set(k, xsN.get(k) + 1)
    xsW.set(k, xsW.get(k) + (r > 0 ? 1 : 0))
    xsP.set(k, xsP.get(k) + r)
if xvE.size() > 0
    for k = xvE.size() - 1 to 0
        float ve = xvE.get(k)
        float r = na
        if low <= xvS.get(k)
            r := (xvS.get(k) / ve - 1) * 100
        else if high >= xvT.get(k)
            r := (xvT.get(k) / ve - 1) * 100
        else if bar_index - xvB.get(k) >= czHold
            r := (close / ve - 1) * 100
        if not na(r)
            r -= 2 * czFee
            xAdd(1, r)
            if xvF.get(k)
                xAdd(3, r)
            if xvR.get(k)
                xAdd(0, r)
                if xvF.get(k)
                    xAdd(2, r)
                xsLast.push(str.format_time(xvTm.get(k), "MM/dd HH:mm", "Asia/Seoul") + " " + (r >= 0 ? "+" : "") + str.tostring(r, "#.##") + "%")
                if xsLast.size() > 5
                    xsLast.shift()
            xvE.remove(k)
            xvS.remove(k)
            xvT.remove(k)
            xvB.remove(k)
            xvR.remove(k)
            xvTm.remove(k)
            xvF.remove(k)
if xOk
    xvE.push(close)
    xvS.push(xSl)
    xvT.push(xTp)
    xvB.push(bar_index)
    xvR.push(xBot)
    xvTm.push(time)
    xvF.push(not xBadF)
    if na(xsFirst)
        xsFirst := time
// ───────── ▲ 기본 근거 매수 신호 성적 (0 = 신호 손절·익절, 1 = 원금 % 손절 + 신호 익절) ─────────
var bvE = array.new_float()
var bvS = array.new_float()
var bvS2 = array.new_float()
var bvT = array.new_float()
var bvB = array.new_int()
var bvD = array.new_bool()       // 각 기준 결과 났는지
var bvD2 = array.new_bool()
var bsN = array.new_int(2, 0)
var bsW = array.new_int(2, 0)
var bsP = array.new_float(2, 0.0)
var int bsFirst = na
var int blT = na
bAdd(int k, float r) =>
    bsN.set(k, bsN.get(k) + 1)
    bsW.set(k, bsW.get(k) + (r > 0 ? 1 : 0))
    bsP.set(k, bsP.get(k) + r)
bHit(float ve, float sv, float tv, int b0) =>
    float r = na
    if not na(sv) and low <= sv
        r := (sv / ve - 1) * 100
    else if not na(tv) and high >= tv
        r := (tv / ve - 1) * 100
    else if bar_index - b0 >= czHold
        r := (close / ve - 1) * 100
    r
if bvE.size() > 0
    for k = bvE.size() - 1 to 0
        float ve = bvE.get(k)
        if not bvD.get(k)
            float r = bHit(ve, bvS.get(k), bvT.get(k), bvB.get(k))
            if not na(r)
                bAdd(0, r - 2 * czFee)
                bvD.set(k, true)
        if not bvD2.get(k)
            float r2 = bHit(ve, bvS2.get(k), bvT.get(k), bvB.get(k))
            if not na(r2)
                bAdd(1, r2 - 2 * czFee)
                bvD2.set(k, true)
        if bvD.get(k) and bvD2.get(k)
            bvE.remove(k)
            bvS.remove(k)
            bvS2.remove(k)
            bvT.remove(k)
            bvB.remove(k)
            bvD.remove(k)
            bvD2.remove(k)
if buy and barstate.isconfirmed
    blT := time
if buy
    bvE.push(close)
    bvS.push(sl)
    bvS2.push(na(czCapPct) ? sl : close * (1 - czCapPct / 100))
    bvT.push(tp)
    bvB.push(bar_index)
    bvD.push(false)
    bvD2.push(false)
    if na(bsFirst)
        bsFirst := time
xStatTxt(int k) =>
    int n = xsN.get(k)
    n == 0 ? "아직 결과 없음" : str.tostring(n) + "번 · 승률 " + str.tostring(xsW.get(k) * 100.0 / n, "#") + "% · 한 번 평균 " + (xsP.get(k) >= 0 ? "+" : "") + str.tostring(xsP.get(k) / n, "#.##") + "% · 합계 " + (xsP.get(k) >= 0 ? "+" : "") + str.tostring(xsP.get(k), "#.#") + "%"

if barstate.islast and czOn
    table.clear(czTb, 0, 0, 1, 7)
    line.delete(czLE)
    line.delete(czLS)
    line.delete(czLT)
    label.delete(czBE)
    label.delete(czBS)
    label.delete(czBT)
    RD = color.new(#8B2E2E, 30)
    GN = color.new(#2e7d32, 35)
    if na(czE)
        czC(0, 0, "진입 계산기 · 이 차트에 아직 신호가 없어요", color.new(#617B55, 10))
        table.merge_cells(czTb, 0, 0, 1, 0)
    else
        float e = czMineOk ? czEP : czE
        float sv = czMineOk ? czSP : czS
        float tv = czMineOk ? czTP : czT
        float slP = (1 - sv / e) * 100
        bool badOrd = sv >= e or (not na(tv) and tv <= e)
        float tpP = na(tv) ? na : (tv / e - 1) * 100
        float notl = czMarg * czLev
        float lossA = notl * (slP + 2 * czFee) / 100
        float winA = na(tpP) ? na : notl * (tpP - 2 * czFee) / 100
        float maxM = (czSeed * czRisk / 100) / ((slP + 2 * czFee) / 100) / czLev
        float liq = e * (1 - 1 / czLev)
        int ago_ = bar_index - czB
        cE = color.new(#FFD54F, 0)
        cS = color.new(#FF5252, 0)
        cT = color.new(#00E676, 0)
        czLE := line.new(czB, e, bar_index + 5, e, extend = extend.right, color = cE, width = 2)
        czLS := line.new(czB, sv, bar_index + 5, sv, extend = extend.right, color = cS, width = 2)
        czBE := label.new(bar_index + 3, e, "진입 " + str.tostring(e, format.mintick) + (czMineOk ? " (내 선)" : ""), style = label.style_label_left, color = cE, textcolor = color.black, size = size.small)
        czBS := label.new(bar_index + 3, sv, "손절 -" + str.tostring(slP, "#.##") + "% · -" + czW(lossA), style = label.style_label_left, color = cS, textcolor = color.black, size = size.small)
        if not na(tv)
            czLT := line.new(czB, tv, bar_index + 5, tv, extend = extend.right, color = cT, width = 2)
            czBT := label.new(bar_index + 3, tv, "익절 +" + str.tostring(tpP, "#.##") + "% · +" + czW(winA), style = label.style_label_left, color = cT, textcolor = color.black, size = size.small)
        czC(0, 0, "진입 계산기 · 마지막 신호: " + czNm + " · " + (ago_ == 0 ? "지금 봉" : str.tostring(ago_) + "봉 전") + " · 진입 " + str.tostring(e, format.mintick) + " · 증거금 " + czW(czMarg) + " (≈" + czU(czMarg) + ") × " + str.tostring(czLev) + "배", color.new(#617B55, 10))
        table.merge_cells(czTb, 0, 0, 1, 0)
        czC(0, 1, "손절 " + str.tostring(sv, format.mintick) + (czMineOk ? " (내 선)" : ""))
        czC(1, 1, badOrd ? "순서가 틀려요 · 손절 < 진입 < 익절 로 넣어주세요" : "-" + str.tostring(slP, "#.##") + "% → -" + czW(lossA) + " (시드의 " + str.tostring(lossA / czSeed * 100, "#.#") + "%)", lossA / czSeed * 100 > czRisk ? RD : na, "수수료 포함")
        czC(0, 2, na(tv) ? "익절" : "익절 " + str.tostring(tv, format.mintick) + (czMineOk ? " (내 선)" : ""))
        czC(1, 2, na(tv) ? "정해진 익절 없음 · " + tpTxt : "+" + str.tostring(tpP, "#.##") + "% → +" + czW(winA) + " · 손익비 1 : " + str.tostring(winA / lossA, "#.##"))
        bool isDump = str.contains(czKey, "|투매|")
        [gn, gw, ga, gaw, gal, gp] = czGet(czKey)
        czC(0, 3, "봇 검증 승률")
        if isDump
            czC(1, 3, "투매는 내 방식(봉 끝나고 다음 봉 진입 · 반등에 매도)대로 하니까 판정 안 함")
        else if na(gn)
            czC(1, 3, "이 시장·봉 조합은 봇 검증이 없어요 (" + czKey + ")", RD)
        else
            bool slDiff = czMineOk
            czC(1, 3, str.tostring(gn, "#") + "회 · 승률 " + str.tostring(gw, "#") + "% · 한 번 평균 " + czSg(ga) + str.tostring(ga, "#.##") + "% · 이길 때 " + czSg(gaw) + str.tostring(gaw, "#.##") + "% · 질 때 " + str.tostring(gal, "#.##") + "% · " + gp + (gn < 30 ? " · 횟수 적음" : ""), na, "봇 문자와 같은 조건 · 신호 손절·익절 그대로 들어갔을 때 · 레버리지 안 곱한 값" + (slDiff ? " · 내 선을 쓰는 중이라 이건 신호 손절·익절 기준이에요 (내 선 기준은 아래 줄)" : ""))
            czC(0, 4, "내 돈으로")
            czC(1, 4, "한 번 평균 " + czSg(ga) + czW(notl * ga / 100) + " · " + (ga > 0 ? "검증상 평균 플러스" : "검증상 평균 손해 · 들어가지 않는 게 나아요") + (slDiff ? " · 신호 손절·익절 기준" : ""), ga > 0 ? GN : RD)
        czC(0, 5, "한도")
        czC(1, 5, "시드 " + str.tostring(czRisk) + "% 한도면 증거금 최대 " + czW(maxM) + " (≈" + czU(maxM) + ")", czMarg > maxM ? RD : na)
        czC(0, 7, "내 선 기준 승률")
        if not czMine
            czC(1, 7, "'내가 옮긴 선 쓰기'를 켜면 내 손절·익절 폭으로 이 차트 과거 같은 신호를 다시 계산해요")
        else if not czMineOk
            czC(1, 7, "내 선 순서가 틀려요 · 손절 < 진입 < 익절 로 선을 옮겨주세요 (지금은 신호 값으로 계산)", RD)
        else
            int mn = czSN.get(czK)
            float mw = mn > 0 ? czSW.get(czK) * 100.0 / mn : na
            float ma = mn > 0 ? czSP_.get(czK) / mn : na
            czC(1, 7, mn == 0 ? "이 차트에 결과가 난 같은 신호가 아직 없어요 (차트를 더 과거로 넘기면 늘어요)" : "이 차트 과거 같은 신호 " + str.tostring(mn) + "번 · 손절 -" + str.tostring(czDS, "#.##") + "% / 익절 +" + str.tostring(czDT, "#.##") + "% 로 걸었다면 승률 " + str.tostring(mw, "#") + "% · 한 번 평균 " + czSg(ma) + str.tostring(ma, "#.##") + "% (" + czSg(ma) + czW(notl * ma / 100) + ")" + (mn < 30 ? " · 횟수 적음" : ""), mn == 0 ? na : ma > 0 ? GN : RD, "신호 봉 종가에 진입 · 한 봉에 둘 다 닿으면 손절로 침 · " + str.tostring(czHold) + "봉 안에 안 닿으면 그 봉 종가로 정리 · 수수료 포함 · 차트에 불러온 봉만큼만 셈")
        czC(0, 6, "청산가 (대략)")
        czC(1, 6, str.tostring(liq, format.mintick) + (liq >= sv ? " · 손절보다 먼저 청산돼요! 레버리지를 낮추세요" : " · 손절이 먼저 닿아요"), liq >= sv ? RD : na)

// ───────── 신호 성적 표 (작게 · 칸 나눔) ─────────
czSP2 = czStPos == "오른쪽 위" ? position.top_right : czStPos == "오른쪽 가운데" ? position.middle_right : czStPos == "오른쪽 아래" ? position.bottom_right : czStPos == "왼쪽 위" ? position.top_left : position.bottom_left
var table stTb = table.new(czSP2, 5, 11, bgcolor = color.new(#111111, 10), border_color = color.new(#617B55, 0), border_width = 1, frame_color = color.new(#617B55, 0), frame_width = 1)
stC(int c, int r, string t, color bg = na, string tip = "", color tc = color.white) =>
    table.cell(stTb, c, r, t, text_color = tc, text_size = size.small, text_halign = c == 0 ? text.align_left : text.align_right, bgcolor = na(bg) ? color.new(#111111, 10) : bg, tooltip = tip)
stRow(int r, string nm, int n, int w, float p, float mul, bool hl = false) =>
    stC(0, r, (hl ? "▶ " : "") + nm, na, hl ? "마지막 동시 돌파 신호가 이 줄에 들어가요" : "", hl ? color.new(#FFD54F, 0) : color.white)
    stC(1, r, n == 0 ? "-" : str.tostring(n))
    stC(2, r, n == 0 ? "-" : str.tostring(w * 100.0 / n, "#") + "%")
    stC(3, r, n == 0 ? "-" : (p >= 0 ? "+" : "") + str.tostring(p / n * mul, "#.##") + "%", n == 0 ? na : p > 0 ? color.new(#2e7d32, 35) : color.new(#8B2E2E, 30))
    stC(4, r, n == 0 ? "-" : (p >= 0 ? "+" : "") + str.tostring(p * mul, "#.#") + "%")
if barstate.islast and czStOn
    table.clear(stTb, 0, 0, 4, 10)
    xlHas = not na(xlT)
    xlOn = xlHas and (na(blT) or xlT >= blT)
    stC(0, 0, "이 차트 신호 성적 (◆ 동시 돌파 · ▲ 기본 근거)" + (na(xsFirst) ? "" : " · " + str.format_time(xsFirst, "yy/MM/dd", "Asia/Seoul") + "~"), color.new(#617B55, 10), "트레이딩뷰 봉 그대로(야간 포함) · 신호 봉 종가 진입 · 한 봉에 둘 다 닿으면 손절 · " + str.tostring(czHold) + "봉 안에 안 닿으면 종가 정리 · 수수료 포함")
    table.merge_cells(stTb, 0, 0, 4, 0)
    stC(0, 1, "구분", color.new(#617B55, 40))
    stC(1, 1, "횟수", color.new(#617B55, 40))
    stC(2, 1, "승률", color.new(#617B55, 40))
    stC(3, 1, "한 번 평균", color.new(#617B55, 40))
    stC(4, 1, "합계", color.new(#617B55, 40))
    stRow(2, "★ (신호 손절)", xsN.get(0), xsW.get(0), xsP.get(0), 1, xlOn and xlStar)
    stRow(3, "전체 (신호 손절)", xsN.get(1), xsW.get(1), xsP.get(1), 1, xlOn)
    stRow(6, "전체 · 200선 오르는 중 [후보]", xsN.get(3), xsW.get(3), xsP.get(3), 1, xlOn and xlUp)
    stRow(7, "★ · 200선 오르는 중", xsN.get(2), xsW.get(2), xsP.get(2), 1, xlOn and xlStar and xlUp)
    stRow(4, "★ 원금 " + str.tostring(czRisk) + "% 손절", ysN.get(0), ysW.get(0), ysP.get(0), 1, xlOn and xlStar)
    stRow(5, "전체 원금 " + str.tostring(czRisk) + "% 손절", ysN.get(1), ysW.get(1), ysP.get(1), 1, xlOn)
    blLast = not na(blT) and (na(xlT) or blT > xlT)   // 둘 중 더 최근 신호에 ▶
    blName = name == "" ? "기본 근거" : str.split(name, " (").get(0)
    stRow(8, "▲ " + blName + " (신호 손절·익절)", bsN.get(0), bsW.get(0), bsP.get(0), 1, blLast)
    stRow(9, "▲ 원금 " + str.tostring(czRisk) + "% 손절", bsN.get(1), bsW.get(1), bsP.get(1), 1, blLast)
    xlHas2 = xlHas and not blLast
    stC(0, 10, blLast ? "마지막 신호 " + str.format_time(blT, "MM/dd HH:mm", "Asia/Seoul") + " · ▲ " + blName + " → ▶ 줄 참고" : xlHas2 ? "마지막 신호 " + str.format_time(xlT, "MM/dd HH:mm", "Asia/Seoul") + " · ◆ " + (xlStar ? "★" : "★ 아님") + " · 200선 " + (xlUp ? "오르는 중" : "내려가는 중") + " → ▶ 줄 참고" : "아직 신호 없음", color.new(#3a3a1a, 0), "", color.new(#FFD54F, 0))
    table.merge_cells(stTb, 0, 10, 4, 10)

// ───────── 오늘의 매매 (하루 한 번) ─────────
// 이 차트에서 하루(한국 날짜) 첫 번째로 뜬 '쓸 만한 롱 신호' 하나만 표시·알림: ★(1·3·5분) 또는 5분봉 동시 돌파 + 200선 오르는 중 [후보]
// 알림 만들기: 지표 이름 옆 … → 알림 추가 → 조건 '검증 근거 v2' → 'alert() 함수 호출만'
GD = "오늘의 매매 (하루 한 번)"
tdOn = input.bool(true, "오늘의 매매 표시·알림", group = GD)
tdSig = xOk and (xBot or (xTf == "5" and s200 > s200[40]))
var int tdDay = na
kDay = year(time, "Asia/Seoul") * 10000 + month(time, "Asia/Seoul") * 100 + dayofmonth(time, "Asia/Seoul")
tdFire = tdOn and tdSig and barstate.isconfirmed and (na(tdDay) or kDay != tdDay)
tdHist = tdOn and tdSig and (na(tdDay) or kDay != tdDay)
if tdHist
    tdDay := kDay
plotshape(tdHist, "오늘의 매매", shape.labelup, location.belowbar, color.new(#FFD54F, 0), text = "오늘", textcolor = color.black, size = size.small)
if tdFire
    alert("[오늘의 매매] " + syminfo.ticker + " " + timeframe.period + "분 · " + (xBot ? "50·100 동시 돌파 ★" : "50·100 동시 돌파 + 200선 오르는 중 [후보]") + " · 진입 " + str.tostring(close, format.mintick) + " · 손절 " + str.tostring(xSl, format.mintick) + " (-" + str.tostring((1 - xSl / close) * 100, "#.##") + "%) · 익절 " + str.tostring(xTp, format.mintick) + " (+" + str.tostring((xTp / close - 1) * 100, "#.##") + "%) · 원금 " + str.tostring(czRisk) + "% 한도 증거금 최대 " + str.tostring(math.round((czSeed * czRisk / 100) / (((1 - xSl / close) * 100 + 2 * czFee) / 100) / czLev), "#,##0") + "원 · 오늘은 이것 하나만", alert.freq_once_per_bar_close)

var string[] sgK = array.from('BTC|15|매수|50·100 동시 돌파', 'BTC|15|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배)', 'BTC|15|매수|저점 반등', 'BTC|240|매도|50·100 동시 이탈', 'BTC|240|매수|50·100 동시 돌파', 'BTC|240|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배)', 'BTC|240|매수|50·100 동시 돌파 · 큰 흐름 하락 중', 'BTC|240|매수|추세 돌파', 'BTC|3|매수|50·100 동시 돌파', 'BTC|3|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배)', 'BTC|3|투매|투매 · 반등 여유 있음', 'BTC|3|투매|투매 · 위 이평선 가까움', 'BTC|30|매도|20선 과이격 음봉', 'BTC|30|매도|50·100 동시 이탈', 'BTC|30|매도|과열 후 장악 음봉', 'BTC|30|매수|50·100 동시 돌파', 'BTC|30|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배)', 'BTC|30|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배) · 큰 흐름 하락 중', 'BTC|30|매수|50·100 동시 돌파 · 큰 흐름 하락 중', 'BTC|30|매수|추세 돌파', 'BTC|5|매수|50·100 동시 돌파', 'BTC|5|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배)', 'BTC|5|투매|투매 · 반등 여유 있음', 'BTC|5|투매|투매 · 위 이평선 가까움', 'BTC|60|매수|50·100 동시 돌파', 'BTC|60|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배)', 'BTC|60|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배) · 큰 흐름 하락 중', 'BTC|60|매수|50·100 동시 돌파 · 큰 흐름 하락 중', 'BTC|60|매수|변동성 돌파일 돌파', 'BTC|D|매수|50·100 동시 돌파', 'BTC|D|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배)', 'BTC|D|매수|터틀 (20일 고점 돌파)', 'ETH|15|매도|20선 과이격 음봉', 'ETH|15|매수|50·100 동시 돌파', 'ETH|15|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배)', 'ETH|15|매수|저점 반등', 'ETH|240|매도|50·100 동시 이탈', 'ETH|240|매수|50·100 동시 돌파', 'ETH|240|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배)', 'ETH|240|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배) · 큰 흐름 하락 중', 'ETH|240|매수|50·100 동시 돌파 · 큰 흐름 하락 중', 'ETH|240|매수|추세 돌파', 'ETH|3|매수|50·100 동시 돌파', 'ETH|3|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배)', 'ETH|3|투매|투매 · 반등 여유 있음', 'ETH|3|투매|투매 · 위 이평선 가까움', 'ETH|30|매도|50·100 동시 이탈', 'ETH|30|매수|50·100 동시 돌파', 'ETH|30|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배)', 'ETH|30|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배) · 큰 흐름 하락 중', 'ETH|30|매수|50·100 동시 돌파 · 큰 흐름 하락 중', 'ETH|30|매수|추세 돌파', 'ETH|5|매수|50·100 동시 돌파', 'ETH|5|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 3배)', 'ETH|5|투매|투매 · 반등 여유 있음', 'ETH|5|투매|투매 · 위 이평선 가까움', 'ETH|60|매도|20선 과이격 음봉', 'ETH|60|매도|50선 반등 실패', 'ETH|60|매수|50·100 동시 돌파', 'ETH|60|매수|50·100 동시 돌파 (RSI 30 터치 + 거래량 
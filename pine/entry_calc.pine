        'SOXL|D|매수|터틀 (20일 고점 돌파)' => [57.0, 42.0, 10.06, 37.15, -9.65, 17.07, '16.12~26.09']
        => [na, na, na, na, na, na, '']
symLab = str.contains(syminfo.ticker, 'BTC') ? 'BTC' : str.contains(syminfo.ticker, 'ETH') ? 'ETH' : str.contains(syminfo.ticker, 'SOXL') ? 'SOXL' : ''
tfLab = timeframe.isdaily ? 'D' : timeframe.period
sigKind = str.startswith(sigIn, '매도 · ') ? '매도' : str.startswith(sigIn, '투매') ? '투매' : '매수'
sigName = str.startswith(sigIn, '매도 · ') ? str.replace(sigIn, '매도 · ', '') : sigIn
sigKey = symLab + '|' + tfLab + '|' + sigKind + '|' + sigName + (bigDnIn ? ' · 큰 흐름 하락 중' : '')
[sgNv, sgWv, sgAv, sgAWv, sgALv, sgSLv, sgPv] = sgGet(sigKey)
sgI = sigIn == '없음 (내 판단)' or na(sgNv) ? -1 : 0

// ───────── 표 · 선 ─────────
BGC = color.new(#111111, 10)
HD  = color.new(#617B55, 10)
RED = color.new(#8B2E2E, 30)
GRN = color.new(#2e7d32, 35)
tPos = tblPos == '오른쪽 위' ? position.top_right : tblPos == '오른쪽 가운데' ? position.middle_right : tblPos == '오른쪽 아래' ? position.bottom_right : tblPos == '왼쪽 위' ? position.top_left : position.bottom_left
var table tb = table.new(tPos, 2, 10, bgcolor = BGC, border_color = color.new(#617B55, 0), border_width = 1, frame_color = color.new(#617B55, 0), frame_width = 1)
cell(int c, int r, string t, color bg = na, string tip = '') =>
    table.cell(tb, c, r, t, text_color = color.white, text_size = tSz, text_halign = text.align_left, bgcolor = na(bg) ? BGC : bg, tooltip = tip)
f2(float v) => str.tostring(v, '#,##0.00')
f1(float v) => str.tostring(v, '#,##0.0')
fp(float v) => str.tostring(v, format.mintick)
fw(float v) => str.tostring(math.round(v), '#,##0') + '원'
fu(float v) => str.tostring(v / fx, '#,##0.0') + ' USDT'
sg(float v) => v >= 0 ? '+' : ''

var line lE = na
var line lS = na
var line lT = na
if barstate.islast and showLn and valid
    line.delete(lE)
    line.delete(lS)
    line.delete(lT)
    lE := line.new(bar_index - 30, ent, bar_index + 10, ent, extend = extend.right, color = color.new(#B0B0B0, 0), width = 1)
    lS := line.new(bar_index - 30, slp, bar_index + 10, slp, extend = extend.right, color = color.new(#E53935, 0), width = 2)
    lT := line.new(bar_index - 30, tpp, bar_index + 10, tpp, extend = extend.right, color = color.new(#43A047, 0), width = 2)

if barstate.islast
    table.clear(tb, 0, 0, 1, 9)
    if not valid
        cell(0, 0, '진입 계산기', HD)
        cell(0, 1, isLong ? '롱: 손절가 < 진입가 < 익절가 로 골라주세요' : '숏: 익절가 < 진입가 < 손절가 로 골라주세요', RED)
        table.merge_cells(tb, 0, 0, 1, 0)
        table.merge_cells(tb, 0, 1, 1, 1)
    else
        float notional = marg * lev
        float lossAmt = notional * (slPct + 2 * fee) / 100
        float winAmt  = notional * (tpPct - 2 * fee) / 100
        float lossSeed = lossAmt / seed * 100
        float rr = lossAmt > 0 ? winAmt / lossAmt : na
        float beWin = winAmt + lossAmt > 0 ? lossAmt / (winAmt + lossAmt) * 100 : na
        float maxMarg = (seed * maxRisk / 100) / ((slPct + 2 * fee) / 100) / lev
        float liq = isLong ? ent * (1 - 1 / lev) : ent * (1 + 1 / lev)
        bool liqFirst = isLong ? liq >= slp : liq <= slp

        cell(0, 0, '진입 계산기 · ' + side + ' · 진입 ' + fp(ent) + ' · 증거금 ' + fw(marg) + ' (≈' + fu(marg) + ') × ' + str.tostring(lev) + '배 = ' + fw(notional), HD)
        table.merge_cells(tb, 0, 0, 1, 0)
        cell(0, 1, '손절 ' + fp(slp))
        cell(1, 1, '-' + f2(slPct) + '% → -' + fw(lossAmt) + ' (시드의 ' + f1(lossSeed) + '%)', lossSeed > maxRisk ? RED : na, lossSeed > maxRisk ? '한도(' + str.tostring(maxRisk) + '%)를 넘어요' : '수수료 포함')
        cell(0, 2, '익절 ' + fp(tpp))
        cell(1, 2, '+' + f2(tpPct) + '% → +' + fw(winAmt) + ' (시드의 +' + f1(winAmt / seed * 100) + '%)', na, '수수료 포함')
        cell(0, 3, '손익비')
        cell(1, 3, '1 : ' + str.tostring(rr, '#.##') + ' · 본전 되려면 승률 ' + str.tostring(beWin, '#') + '% 필요')
        if sigIn == '없음 (내 판단)'
            cell(0, 4, '받은 신호')
            cell(1, 4, '없음 · 내 판단 진입은 검증 승률이 없어요 (설정에서 받은 문자 신호를 고르면 떠요)')
        else if sigKind == '투매'
            cell(0, 4, '받은 신호')
            cell(1, 4, sigIn + ' · 투매는 내 방식(봉 끝나고 다음 봉 진입 · 반등에 매도)대로 하니까 판정 안 함 · 위 손절·익절 금액과 아래 한도만 보세요')
        else if sgI < 0
            cell(0, 4, '받은 신호')
            cell(1, 4, symLab + ' ' + tfLab + ' · ' + sigIn + ' → 이 시장·봉에는 봇이 보내지 않는 신호라 검증이 없어요', RED)
        else
            float n = sgNv
            float w = sgWv
            float av = sgAv
            float aw = sgAWv
            float al = sgALv
            float ssl = sgSLv
            cell(0, 4, '받은 신호 검증')
            cell(1, 4, str.tostring(n, '#') + '회 · 승률 ' + str.tostring(w, '#') + '% · 한 번 평균 ' + sg(av) + f2(av) + '% · 이길 때 ' + sg(aw) + f2(aw) + '% · 질 때 ' + f2(al) + '% · ' + sgPv, na, symLab + ' ' + tfLab + ' · ' + sigKey + ' · 문자에 적힌 손절·익절 그대로 들어갔을 때 · 레버리지 안 곱한 값')
            cell(0, 5, '내 돈으로')
            cell(1, 5, '한 번 평균 ' + sg(av) + fw(notional * av / 100) + ' · 이길 때 +' + fw(notional * aw / 100) + ' · 질 때 ' + fw(notional * al / 100), av > 0 ? GRN : RED, '증거금 × 레버리지 기준')
            string vd = av > 0 ? '검증상 평균 플러스' : '검증상 평균 손해 · 들어가지 않는 게 나아요'
            vd += n < 30 ? ' · 횟수가 ' + str.tostring(n, '#') + '번뿐이라 참고만' : ''
            bool dirBad = (sigKind == '매도') != (not isLong)
            vd += dirBad ? ' · 신호는 ' + (sigKind == '매도' ? '숏' : '롱') + '인데 방향이 ' + side + '예요!' : ''
            bool slBad = ssl > 0 and slPct < ssl * 0.8
            vd += slBad ? ' · 내 손절(' + f2(slPct) + '%)이 신호 손절(평균 ' + f2(ssl) + '%)보다 좁아서 이 승률이 안 맞아요' : ''
            cell(0, 6, '판정')
            cell(1, 6, vd, av > 0 and not dirBad and not slBad ? GRN : RED)
        cell(0, 7, '한도')
        cell(1, 7, '시드 ' + str.tostring(maxRisk) + '% 한도면 증거금 최대 ' + fw(maxMarg) + ' (≈' + fu(maxMarg) + ', ' + str.tostring(lev) + '배 기준)', marg > maxMarg ? RED : na)
        cell(0, 8, '청산가 (대략)')
        cell(1, 8, fp(liq) + (liqFirst ? ' · 손절보다 먼저 청산돼요! 레버리지를 낮추세요' : ' · 손절이 먼저 닿아요'), liqFirst ? RED : na, '유지증거금·수수료 때문에 실제 청산가는 이보다 조금 더 가까워요')
